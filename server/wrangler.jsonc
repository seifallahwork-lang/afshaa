// Cloudflare configuration for the Afsha game server.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afsha-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "observability": { "enabled": true },

  // One Durable Object per game room.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // "new_sqlite_classes" is REQUIRED for Durable Objects on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  "vars": {
    // Which websites may talk to this server. After your first Vercel deploy,
    // change this to your site, e.g. "https://afsha.vercel.app" (comma-separate several).
    "ALLOWED_ORIGINS": "*"
  }
}
